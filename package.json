{
  "name": "omarchy-kids-game-turbo-tables",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "preinstall": "node -e \"console.error('Do not install packages inside the plugin checkout: node_modules symlinks fail omarchy plugin validate. Tools run through npx; see docs/environment.md.'); process.exit(1)\"",
    "build": "npx --yes esbuild@0.28.2 src/engine/index.ts --bundle --format=esm --platform=neutral --target=es2016 --outfile=engine/engine.mjs",
    "check:types": "npx --yes --package=typescript@7.0.2 tsc --noEmit",
    "check:boundary": "node src/tools/check-boundary.ts",
    "check:bundle": "node src/tools/verify-bundle.ts",
    "scan": "node src/tools/scan.ts",
    "test": "node --test \"tests/**/*.test.ts\""
  }
}
